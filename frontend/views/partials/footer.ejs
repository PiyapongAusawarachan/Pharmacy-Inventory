<script>
  // Close an open menu when another opens or when clicking elsewhere.
  document.addEventListener('click', function (e) {
    document.querySelectorAll('details.drop[open]').forEach(function (d) { if (!d.contains(e.target)) d.removeAttribute('open'); });
  });
</script>
