<%- include('../partials/header') %>

<div class="page-head"><h1><%= t(mode === 'new' ? 'Add patient' : 'Edit patient') %></h1></div>
<%- include('../partials/errors') %>

<form class="form card card-body" method="post" action="<%= mode === 'new' ? '/patients' : '/patients/' + p.patient_code %>">
  <% if (mode === 'edit') { %>
    <label><%= t('Patient code') %><input type="text" value="<%= p.patient_code %>" disabled></label>
  <% } %>
  <div class="form-row">
    <label><%= t('Name') %>
      <input type="text" name="name" value="<%= p.name %>" maxlength="150" required>
    </label>
    <label><%= t('Phone') %>
      <input type="text" name="phone" value="<%= p.phone || '' %>" maxlength="30">
    </label>
  </div>
  <% if (mode === 'new') { %><p class="hint"><%= t('The patient code is assigned automatically. You can record allergies on the next page.') %></p><% } %>
  <div class="form-actions">
    <button class="btn btn-primary" type="submit"><%= t('Save') %></button>
    <a class="btn" href="<%= mode === 'new' ? '/patients' : '/patients/' + p.patient_code %>"><%= t('Cancel') %></a>
  </div>
</form>

<%- include('../partials/footer') %>
