<%- include('../partials/header') %>

<div class="page-head"><h1><%= t(mode === 'new' ? 'Add staff' : 'Edit staff') %></h1></div>
<%- include('../partials/errors') %>

<form class="form card-body card" method="post" action="<%= mode === 'new' ? '/staff' : '/staff/' + s.staff_id %>">
  <label><%= t('Username') %>
    <% if (mode === 'new') { %>
      <input type="text" name="username" value="<%= s.username %>" maxlength="50" required>
    <% } else { %>
      <input type="text" value="<%= s.username %>" disabled>
    <% } %>
  </label>

  <label><%= t('Full name') %>
    <input type="text" name="full_name" value="<%= s.full_name %>" maxlength="100" required>
  </label>

  <label><%= t('Role') %>
    <select name="role" required>
      <% STAFF_ROLES.forEach(function (r) { %>
        <option value="<%= r %>" <%= s.role === r ? 'selected' : '' %>><%= t(r) %></option>
      <% }) %>
    </select>
  </label>

  <label><%= t('Password') %> <%= mode === 'edit' ? t('(leave empty to keep the current one)') : '' %>
    <input type="password" name="password" autocomplete="new-password" <%= mode === 'new' ? 'required' : '' %>>
  </label>

  <% if (mode === 'edit') { %>
    <label class="check"><input type="checkbox" name="is_active" <%= s.is_active ? 'checked' : '' %>> <%= t('Account is active') %></label>
  <% } %>

  <div class="form-actions">
    <button class="btn btn-primary" type="submit"><%= t('Save') %></button>
    <a class="btn" href="/staff"><%= t('Cancel') %></a>
  </div>
</form>

<%- include('../partials/footer') %>
