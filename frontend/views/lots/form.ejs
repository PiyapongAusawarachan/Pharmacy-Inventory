<%- include('../partials/header') %>

<div class="page-head"><h1><%= t(mode === 'new' ? 'Receive stock lot' : 'Edit stock lot') %></h1></div>
<%- include('../partials/errors') %>

<form class="form card-body card" method="post" action="<%= mode === 'new' ? '/lots' : '/lots/' + lot.lot_id %>">

  <% if (mode === 'new') { %>
    <label><%= t('Medicine') %>
      <select name="medicine_id" required data-search>
        <option value=""><%= t('— pick one —') %></option>
        <% medicines.forEach(function (m) { %>
          <option value="<%= m.medicine_id %>" <%= Number(lot.medicine_id) === m.medicine_id ? 'selected' : '' %>>
            <%= m.generic_name %> <%= m.strength %> <%= m.dosage_form %><%= m.brand_name ? ' (' + m.brand_name + ')' : '' %> — <%= m.units_per_pack %> <%= m.base_unit %>/<%= t('pack') %>
          </option>
        <% }) %>
      </select>
    </label>
  <% } else { %>
    <label><%= t('Medicine') %>
      <input type="text" disabled value="<%= lot.generic_name %> <%= lot.strength %> <%= lot.dosage_form %>">
      <small><%= t('The medicine of a lot cannot be changed after receiving.') %></small>
    </label>
  <% } %>

  <label><%= t('Supplier') %>
    <select name="supplier_id" required>
      <option value=""><%= t('— pick one —') %></option>
      <% suppliers.forEach(function (s) { %>
        <option value="<%= s.supplier_id %>" <%= Number(lot.supplier_id) === s.supplier_id ? 'selected' : '' %>><%= s.name %></option>
      <% }) %>
    </select>
  </label>

  <div class="form-row">
    <label><%= t('Lot number') %>
      <input type="text" name="lot_number" value="<%= lot.lot_number %>" maxlength="50" required>
    </label>
    <label><%= t('Unit cost (per base unit)') %>
      <input type="number" name="unit_cost" value="<%= lot.unit_cost %>" min="0" step="0.01">
    </label>
  </div>

  <div class="form-row">
    <label><%= t('Manufacture date (optional)') %>
      <input type="date" name="mfg_date" value="<%= lot.mfg_date || '' %>">
    </label>
    <label><%= t('Expiry date') %>
      <input type="date" name="expiry_date" value="<%= lot.expiry_date %>" required>
    </label>
  </div>

  <% if (mode === 'new') { %>
    <div class="form-row">
      <label><%= t('Packs received') %>
        <input type="number" name="packs" value="<%= lot.packs %>" min="1" step="1" required>
        <small><%= t('Stored in base units: packs × units per pack.') %></small>
      </label>
      <label><%= t('Received date') %>
        <input type="date" name="received_date" value="<%= lot.received_date || '' %>">
      </label>
    </div>
  <% } else { %>
    <div class="form-row">
      <label><%= t('Quantity on hand') %> (<%= lot.base_unit %>)
        <input type="number" name="qty_on_hand" value="<%= lot.qty_on_hand %>" min="0" step="1" required>
        <small><%= t('Received: {0}. Change this only to correct the count (stock adjustment).', lot.qty_received) %></small>
      </label>
      <label><%= t('Status') %>
        <select name="status" required>
          <% LOT_STATUSES.forEach(function (s) { %>
            <option value="<%= s %>" <%= lot.status === s ? 'selected' : '' %>><%= t(s) %></option>
          <% }) %>
        </select>
        <small><%= t('Only lots marked ready to sell are sold.') %></small>
      </label>
    </div>
  <% } %>

  <div class="form-actions">
    <button class="btn btn-primary" type="submit"><%= t('Save') %></button>
    <a class="btn" href="/lots"><%= t('Cancel') %></a>
  </div>
</form>

<%- include('../partials/footer') %>
