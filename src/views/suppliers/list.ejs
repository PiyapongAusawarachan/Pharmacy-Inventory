<%- include('../partials/header') %>

<div class="page-head">
  <h1>Suppliers</h1>
  <% if (canWrite) { %><a class="btn btn-primary" href="/suppliers/new">Add supplier</a><% } %>
</div>

<table class="table">
  <thead>
    <tr><th>Name</th><th>Phone</th><th>Address</th><th>Lots</th><th>Status</th><% if (canWrite) { %><th class="actions-col">Actions</th><% } %></tr>
  </thead>
  <tbody>
    <% if (!rows.length) { %><tr><td colspan="6" class="empty">No suppliers yet.</td></tr><% } %>
    <% rows.forEach(function (s) { %>
      <tr class="<%= s.is_active ? '' : 'row-inactive' %>">
        <td><%= s.name %></td>
        <td><%= s.phone || '' %></td>
        <td><%= s.address || '' %></td>
        <td><%= s.lot_count %></td>
        <td><%= s.is_active ? 'Active' : 'Inactive' %></td>
        <% if (canWrite) { %>
          <td class="actions">
            <a class="btn btn-small" href="/suppliers/<%= s.supplier_id %>/edit">Edit</a>
            <form method="post" action="/suppliers/<%= s.supplier_id %>/delete" onsubmit="return confirm('Delete this supplier? If it has delivered lots it is deactivated instead.');">
              <button class="btn btn-small btn-danger" type="submit">Delete</button>
            </form>
          </td>
        <% } %>
      </tr>
    <% }) %>
  </tbody>
</table>

<%- include('../partials/footer') %>
