# Copy this file to .env and adjust if needed.

# Web server
PORT=3000

# PostgreSQL (runs locally via docker compose)
PG_HOST=localhost
PG_PORT=5432
PG_USER=pharmacy
PG_PASSWORD=pharmacy
PG_DATABASE=pharmacy

# MongoDB (runs locally via docker compose)
MONGO_URL=mongodb://localhost:27017
MONGO_DB=pharmacy

# Local image storage (no external hosting allowed)
UPLOAD_DIR=uploads

# Days before expiry that a lot counts as "near expiry" (GPP: 6-8 months)
NEAR_EXPIRY_DAYS=180
